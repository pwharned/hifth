{
  "manifest_version": 3,
  "name": "Clausula",
  "version": "0.1.0",
  "description": "Create reviewed sentence-mining cloze cards from exact webpage selections.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/main.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost:8765/*",
    "https://translate.googleapis.com/*"
  ]
}
